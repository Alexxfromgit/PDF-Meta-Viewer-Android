<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/viewer_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/colorSurface">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/app_name" android:textAppearance="?attr/textAppearanceTitleLarge" android:accessibilityHeading="true"/>
<com.google.android.material.button.MaterialButton android:id="@+id/theme_button" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dark_mode" android:minHeight="48dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<com.google.android.material.button.MaterialButton android:id="@+id/open_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/open_pdf" android:minHeight="48dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/export_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/export_json" android:enabled="false" android:minHeight="48dp"/>
</LinearLayout>
<LinearLayout android:id="@+id/file_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp" android:visibility="gone">
<TextView android:id="@+id/file_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceTitleMedium" android:maxLines="2" android:ellipsize="middle" android:textIsSelectable="true"/>
<TextView android:id="@+id/file_facts" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceBodyMedium"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<LinearLayout android:id="@+id/welcome" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="24dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome_title" android:textAppearance="?attr/textAppearanceHeadlineSmall" android:gravity="center"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome_description" android:textAppearance="?attr/textAppearanceBodyLarge" android:gravity="center" android:layout_marginTop="12dp"/>
</LinearLayout>
<include layout="@layout/viewer_results"/>
</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ProgressBar android:id="@+id/progress" android:layout_width="24dp" android:layout_height="24dp" android:visibility="gone" android:contentDescription="@string/working"/>
<TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingVertical="8dp" android:textAppearance="?attr/textAppearanceBodySmall" android:accessibilityLiveRegion="polite"/>
<com.google.android.material.button.MaterialButton android:id="@+id/open_export" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/open_export" android:visibility="gone"/>
</LinearLayout>
</LinearLayout>
